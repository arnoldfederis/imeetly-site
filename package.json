    "framer-motion": "^13.1.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv-cli": "latest",
