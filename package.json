{
  "name": "@repo/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 4002",
    "build": "next build",
    "start": "next start --port 4002",
    "lint": "bunx biome lint",
    "format": "bunx biome check --write --unsafe",
